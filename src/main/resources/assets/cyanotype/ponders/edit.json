  {
   "t0": 0.0,
   "t1": 4.2,
   "text": "Tap V to edit. Arrows and a ring appear round the build.",
   "title": "1  Handles"
  },
  {
   "t0": 4.2,
   "t1": 9.0,
   "text": "Drag an arrow to move the build along that line, a whole block at a time.",
   "title": "2  Drag an arrow"
  },
  {
   "t0": 9.0,
   "t1": 13.0,
   "text": "Drag the ring for quarter turns. Ctrl and scroll turns from anywhere.",
   "title": "3  Turn it"
  },
  {
   "t0": 13.0,
   "t1": 17.0,
   "text": "Or press on the build itself and look where it should go. Let go to drop it.",
   "title": "4  Carry it"
  },
  {
   "t0": 17.0,
   "t1": 21.0,
   "text": "Ctrl and Z undoes your last move, Ctrl and Y does it again. Delete removes the build.",
   "title": "5  Undo"
  }
 ],
